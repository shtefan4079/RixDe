+void xdpw_wlr_frame_cancel(struct xdpw_screencast_instance *cast) {
+	/* Cancel delayed captures as well as frames already sent to Wayland.
+	 * PipeWire can pause and replace buffers while a frame is pending. */
+	struct xdpw_timer *timer, *tmp;
+	wl_list_for_each_safe(timer, tmp, &cast->ctx->state->timers, link) {
+		if (timer->user_data == cast && timer->func == wlr_frame_capture_timer) {
+			xdpw_destroy_timer(timer);
+		}
+	}
+	if (xdpw_ext_capture_available(cast)) {
+		if (cast->ext_session.frame) {
+			ext_image_copy_capture_frame_v1_destroy(cast->ext_session.frame);
+			cast->ext_session.frame = NULL;
+		}
+	} else if (cast->target->type == MONITOR && cast->ctx->screencopy_manager) {
+		xdpw_wlr_sc_session_close(cast);
+	}
+	cast->current_frame.damage.size = 0;
+}
