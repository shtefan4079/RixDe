[Desktop Entry]
Type=Application
Name=Rix Files
Comment=Browse and manage files with the Rix desktop theme
Exec=rix-files %U
TryExec=rix-files
Icon=system-file-manager
Terminal=false
Categories=System;FileTools;FileManager;
MimeType=inode/directory;
StartupNotify=true
StartupWMClass=org.rixde.Files
