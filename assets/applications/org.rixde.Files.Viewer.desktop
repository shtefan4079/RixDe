[Desktop Entry]
Type=Application
Name=Rix Files Viewer
Comment=View documents, images and text in Rix Files
Exec=rix-files --view %U
TryExec=rix-files
Icon=system-file-manager
Terminal=false
Categories=Utility;Viewer;
MimeType=application/pdf;text/plain;text/markdown;image/png;image/jpeg;image/webp;image/gif;image/bmp;image/tiff;application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/vnd.oasis.opendocument.text;
NoDisplay=true
