import { Theme } from "../../../ui/common/theme.slint";
import { Icons } from "../../../ui/common/icons.slint";
import { Button } from "std-widgets.slint";
import { ComboBox } from "../../../ui/common/combo_box.slint";
import { SettingsCard, SettingsRow, SettingsDivider } from "card.slint";
import { BehaviorSettings } from "behavior.slint";

export struct LanguageChoice {
    id: string,
    name: string,
    detail: string,
}

export global LanguageSettings {
    in-out property <string> selected: "system";
    in-out property <[LanguageChoice]> choices;
    in-out property <string> status;
    callback choose(string);
}

export component LanguageView inherits Rectangle {
    background: transparent;
    preferred-height: content.preferred-height;
    content := VerticalLayout {
        spacing: 16px;

        SettingsCard {
            title: @tr("Display language");
            subtitle: @tr("Choose the interface language for RixDE and desktop applications");

            for choice in LanguageSettings.choices: Rectangle {
                min-height: 58px;
                border-radius: Theme.radius-sm;
                border-width: LanguageSettings.selected == choice.id ? 1.5px : 1px;
                border-color: LanguageSettings.selected == choice.id ? Theme.accent : Theme.border;
                background: LanguageSettings.selected == choice.id ? Theme.surface-active : touch.has-hover ? Theme.surface-hover : Theme.surface;

                HorizontalLayout {
                    padding: 12px; spacing: 14px;

                    VerticalLayout {
                        alignment: center; spacing: 2px; horizontal-stretch: 1;
                        Text { text: choice.name; color: Theme.text-primary; font-size: 14px; font-weight: 600; }
                        Text { text: choice.detail; color: Theme.text-secondary; font-size: 12px; wrap: word-wrap; }
                    }

                    if LanguageSettings.selected == choice.id: VerticalLayout {
                        horizontal-stretch: 0; alignment: center;
                        Rectangle {
                            width: 24px; height: 24px; border-radius: 12px;
                            background: Theme.accent.with-alpha(0.16);
                            Image { source: Icons.check; x: 3px; y: 3px; width: 18px; height: 18px; colorize: Theme.accent; }
                        }
                    }
                }
                touch := TouchArea { clicked => { LanguageSettings.choose(choice.id); } }
            }
        }

        SettingsCard {
            title: @tr("Regional standards and calendar");
            subtitle: @tr("Date formats and first day of the week");

            SettingsRow {
                title: @tr("First day of the week");
                subtitle: @tr("Starting day displayed in calendar widgets and clock");
                ComboBox {
                    model: [@tr("Monday"), @tr("Tuesday"), @tr("Wednesday"), @tr("Thursday"), @tr("Friday"), @tr("Saturday"), @tr("Sunday")];
                    current-index <=> BehaviorSettings.week-start;
                    min-width: 195px;
                }
            }
        }

        if LanguageSettings.status != "": Text {
            text: LanguageSettings.status; color: Theme.text-secondary; wrap: word-wrap;
        }
    }
}
