import { Palette, ListView } from "std-widgets.slint";
import { ScrollArea } from "../../../ui/common/scroll_area.slint";
import { Theme } from "../../../ui/common/theme.slint";
import { SkinFrame, SkinRenderer, ThemeFrame } from "../../../ui/common/frame.slint";
import { Button, IconButton, Field } from "controls.slint";
import { FileCell } from "file_cell.slint";
import { DiskSummary } from "storage.slint";
import { MenuItem, ActionsMenu, NativeActionsMenu } from "context_menu.slint";
import { MenuSurface, DialogBackdrop, MenuHost, SharedMenuItem } from "../../../ui/common/context_menu.slint";
export { DialogBackdrop, MenuHost, SharedMenuItem }
import { FileItem, GridRow, TabItem, PlaceItem, AppItem } from "models.slint";
import { ApplicationChooser, ChooserApplication, ApplicationChooserPanel } from "../../../ui/common/application_chooser.slint";
export { Theme, Palette, SkinFrame, SkinRenderer, FileItem, GridRow, TabItem, PlaceItem, AppItem, MenuItem, NativeActionsMenu, ApplicationChooser, ChooserApplication }

import { ArchiveBrowser, ArchiveMember, ArchivePanel } from "archive.slint";
import { FilePicker, PickerOption, PickerChoice, PickerBar } from "picker.slint";
import { FilePreview, PreviewPanel } from "preview.slint";
import { PropertiesView, PropertyDetail, PropertyPermission, PropertiesPanel } from "properties.slint";
export { PropertiesView, PropertyDetail, PropertyPermission }
export { ArchiveBrowser, ArchiveMember, FilePicker, PickerOption, PickerChoice, FilePreview }

export component FilesWindow inherits Window {
    title: FilePicker.active ? FilePicker.title : "Rix Files";
    preferred-width: 1080px; preferred-height: 720px;
    min-width: 760px; min-height: 480px;
    background: transparent;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size-md;
    in property <bool> desktop-material-supported;
    in property <bool> desktop-material-enabled: true;
    out property <bool> using-desktop-material: root.desktop-material-enabled && root.desktop-material-supported && Theme.is-aero;
    in-out property <bool> native-popup-active;
    in property <[FileItem]> entries;
    in property <[GridRow]> grid-rows;
    in property <[TabItem]> tabs;
    in property <[PlaceItem]> places;
    in property <string> disk-name: @tr("Disk");
    in property <string> disk-mount;
    in property <string> disk-detail: @tr("Reading disk usage…");
    in property <string> disk-usage;
    in property <float> disk-ratio;
    in property <bool> disk-ready;
    in property <image> disk-icon;
    callback open-disk();
    in-out property <length> sidebar-width: 220px;
    in-out property <bool> sidebar-collapsed: false;
    out property <length> effective-sidebar-width: root.sidebar-collapsed ? 0px : Math.clamp(root.sidebar-width, 140px, Math.min(500px, root.width * 0.45));
    callback action-on-place(string, int);
    callback action-on-tab(string, int);
    in property <[AppItem]> applications;
    in property <int> active-tab;
    in-out property <string> location;
    in-out property <string> search;
    in property <bool> busy;
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <bool> can-up;
    in property <bool> show-hidden;
    in property <int> sort-mode;
    in property <bool> grid-view;
    in property <string> status;
    in property <int> selection-count;
    in property <int> trash-count;
    in property <bool> operation-active;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <float> operation-progress;
    in property <string> operation-message;
    in property <int> dialog-kind;
    in property <string> dialog-title;
    in property <string> dialog-text;
    in-out property <string> dialog-value;
    in property <bool> paste-available;
    in property <bool> trash-view;
    in property <string> empty-message;
    in-out property <bool> file-drag-active;
    in-out property <int> drop-hover-entry: -1;
    in-out property <int> drop-hover-place: -1;
    out property <int> grid-columns: Math.clamp(Math.floor((grid.width - Theme.scrollbar-gutter + root.grid-gap) / (Theme.icon-size-lg * 5 + root.grid-gap)), 1, 24);
    out property <int> visible-rows: Math.max(1, Math.floor(file-area.height / (root.grid-view ? root.grid-cell-size + root.grid-gap : root.row-height)));
    private property <length> grid-gap: Theme.spacing-lg;
    private property <length> grid-cell-size: Math.max(1px, (grid.width - Theme.scrollbar-gutter - (root.grid-columns - 1) * root.grid-gap) / root.grid-columns);
    private property <length> row-height: Theme.icon-size-lg + Theme.default-spacing * 2;
    private property <length> tab-width: Theme.font-size-md * 12 + Theme.icon-size;
    private property <length> tab-step: root.tab-width + Theme.spacing-xs;
    private property <length> size-column: Theme.font-size-sm * 7;
    private property <length> modified-column: Theme.font-size-sm * 12;
    private property <length> type-column: Theme.font-size-sm * 9;
    private property <bool> show-type: content.width > Theme.font-size-md * 52;
    private property <color> separator-color: Theme.divider;
    private property <int> hovered-entry: -1;
    private property <int> pressed-entry: -1;
    private property <int> last-left-entry: -1;
    private property <int> previous-left-entry: -1;
    private property <bool> pointer-held;
    private property <bool> rectangle-gesture;
    private property <bool> rectangle-visible;
    private property <bool> drag-threshold-crossed;
    private property <bool> deferred-selection;
    private property <bool> press-control;
    private property <bool> press-shift;
    private property <length> press-x;
    private property <length> press-content-y;
    private property <length> pointer-x;
    private property <length> pointer-y;
    private property <length> content-offset: root.grid-view ? grid.viewport-y : list.viewport-y;
    out property <int> menu-kind: 0;
    private property <length> menu-x;
    private property <length> menu-y;
    private property <int> menu-place: -1;
    private property <bool> menu-place-removable: false;
    private property <int> menu-tab: -1;
    private property <[MenuItem]> file-actions: [
        {action: "open", label: @tr("Open"), shortcut: "Enter", enabled: true, checked: false, destructive: false, separator: false},
        {action: "open-with", label: @tr("Open with…"), enabled: root.selection-count == 1, shortcut: "", checked: false, destructive: false, separator: false},
        {action: "preview", label: @tr("Preview"), enabled: root.selection-count == 1 && !root.trash-view, shortcut: "Space", checked: false, destructive: false, separator: false},
        {action: "terminal", label: @tr("Open terminal here"), enabled: !root.trash-view, shortcut: "", checked: false, destructive: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, destructive: false},
        {action: "cut", label: @tr("Cut"), shortcut: "Ctrl+X", enabled: !root.trash-view, checked: false, destructive: false, separator: false},
        {action: "copy", label: @tr("Copy"), shortcut: "Ctrl+C", enabled: true, checked: false, destructive: false, separator: false},
        {action: "paste", label: @tr("Paste"), shortcut: "Ctrl+V", enabled: root.paste-available && !root.operation-active && !root.trash-view, checked: false, destructive: false, separator: false},
        {action: "copy-path", label: @tr("Copy path"), enabled: root.selection-count > 0 && !root.trash-view, shortcut: "Ctrl+Shift+C", checked: false, destructive: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, destructive: false},
        {action: "rename", label: @tr("Rename…"), shortcut: "F2", enabled: root.selection-count == 1 && !root.operation-active && !root.trash-view, checked: false, destructive: false, separator: false},
        {action: root.trash-view ? "restore" : "trash", label: root.trash-view ? @tr("Restore") : @tr("Move to trash"), shortcut: root.trash-view ? "" : "Del", enabled: !root.operation-active, checked: false, destructive: false, separator: false},
        {action: "delete", label: @tr("Delete permanently…"), shortcut: root.trash-view ? "Del" : "Shift+Del", destructive: true, enabled: !root.operation-active, checked: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, destructive: false},
        {action: "properties", label: @tr("Properties"), shortcut: "Alt+Enter", enabled: true, checked: false, destructive: false, separator: false}
    ];
    private property <[MenuItem]> folder-actions: [
        {action: "new-folder", label: @tr("New folder"), shortcut: "Ctrl+Shift+N", enabled: !root.trash-view && !root.operation-active, checked: false, destructive: false, separator: false},
        {action: "new-file", label: @tr("New file"), shortcut: "Ctrl+Alt+N", enabled: !root.trash-view && !root.operation-active, checked: false, destructive: false, separator: false},
        {action: "paste", label: @tr("Paste"), shortcut: "Ctrl+V", enabled: root.paste-available && !root.operation-active && !root.trash-view, checked: false, destructive: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, destructive: false},
        {action: "terminal", label: @tr("Open terminal here"), enabled: !root.trash-view, shortcut: "", checked: false, destructive: false, separator: false},
        {action: "bookmark", label: @tr("Bookmark folder"), enabled: !root.trash-view, shortcut: "", checked: false, destructive: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, destructive: false},
        {action: "refresh", label: @tr("Refresh"), shortcut: "F5", enabled: true, checked: false, destructive: false, separator: false},
        {action: "hidden", label: @tr("Show hidden files"), shortcut: "Ctrl+H", checked: root.show-hidden, enabled: true, destructive: false, separator: false},
        {action: "undo", label: @tr("Undo"), shortcut: "Ctrl+Z", enabled: root.can-undo && !root.operation-active, checked: false, destructive: false, separator: false},
        {action: "redo", label: @tr("Redo"), shortcut: "Ctrl+Shift+Z", enabled: root.can-redo && !root.operation-active, checked: false, destructive: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, destructive: false},
        {action: "folder-properties", label: @tr("Properties"), shortcut: "Alt+Enter", enabled: true, checked: false, destructive: false, separator: false}
    ];
    private property <[MenuItem]> place-actions: [
        {action: "unpin", label: @tr("Unpin from Places"), enabled: true, checked: false, destructive: false, separator: false, shortcut: ""}
    ];
    private property <[MenuItem]> disk-actions: [
        {action: "open-disk", label: @tr("Open"), shortcut: "Enter", enabled: true, checked: false, destructive: false, separator: false},
        {action: "open-disk-tab", label: @tr("Open in new tab"), shortcut: "Ctrl+T", enabled: true, checked: false, destructive: false, separator: false},
        {action: "disk-terminal", label: @tr("Open terminal here"), shortcut: "", enabled: true, checked: false, destructive: false, separator: false},
        {action: "copy-disk-path", label: @tr("Copy mount path"), shortcut: "Ctrl+Shift+C", enabled: true, checked: false, destructive: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, destructive: false},
        {action: "disk-properties", label: @tr("Properties"), shortcut: "Alt+Enter", enabled: true, checked: false, destructive: false, separator: false}
    ];
    private property <[MenuItem]> tab-actions: [
        {action: "close-tab-menu", label: @tr("Close tab"), shortcut: "Ctrl+W", enabled: root.tabs.length > 1, checked: false, destructive: false, separator: false},
        {action: "close-other-tabs", label: @tr("Close other tabs"), shortcut: "", enabled: root.tabs.length > 1, checked: false, destructive: false, separator: false},
        {action: "close-tabs-right", label: @tr("Close tabs to the right"), shortcut: "", enabled: root.menu-tab >= 0 && root.menu-tab < root.tabs.length - 1, checked: false, destructive: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, destructive: false},
        {action: "duplicate-tab", label: @tr("Duplicate tab"), shortcut: "", enabled: root.tabs.length < 12, checked: false, destructive: false, separator: false},
        {action: "copy-tab-path", label: @tr("Copy path"), shortcut: "Ctrl+Shift+C", enabled: true, checked: false, destructive: false, separator: false}
    ];
    private property <[MenuItem]> options-actions: [
        {action: "undo", label: @tr("Undo"), shortcut: "Ctrl+Z", enabled: root.can-undo && !root.operation-active, checked: false, destructive: false, separator: false},
        {action: "redo", label: @tr("Redo"), shortcut: "Ctrl+Shift+Z", enabled: root.can-redo && !root.operation-active, checked: false, destructive: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, destructive: false},
        {action: "hidden", label: @tr("Show hidden files"), shortcut: "Ctrl+H", checked: root.show-hidden, enabled: true, destructive: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, destructive: false},
        {action: "sort-name", label: @tr("Name"), enabled: true, shortcut: "", checked: root.sort-mode == 0, destructive: false, separator: false},
        {action: "sort-size", label: @tr("Size"), enabled: true, shortcut: "", checked: root.sort-mode == 1, destructive: false, separator: false},
        {action: "sort-modified", label: @tr("Modified"), enabled: true, shortcut: "", checked: root.sort-mode == 2, destructive: false, separator: false},
        {action: "sort-kind", label: @tr("Type"), enabled: true, shortcut: "", checked: root.sort-mode == 3, destructive: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, destructive: false},
        {action: "restore-places", label: @tr("Restore default Places"), enabled: true, shortcut: "", checked: false, destructive: false, separator: false}
    ];
    callback next-menu-index([MenuItem], int, int) -> int;
    pure callback menu-rows-height([MenuItem], length, length) -> length;
    pure callback menu-items-width([MenuItem], length, length) -> length;
    callback show-native-menu([MenuItem], string, length, length, length, length) -> bool;
    callback close-native-menu();
    callback navigate(string);
    callback action(string);
    callback select-entry(int, bool, bool);
    callback begin-file-drag(int) -> bool;
    callback begin-rectangle(bool, bool);
    callback update-rectangle(float, float, float, float, float, float, float, int);
    callback finish-rectangle(bool);
    pure callback place-at([PlaceItem], length, length, length) -> int;
    callback activate-entry(int);
    callback switch-tab(int);
    callback close-tab(int);
    callback open-place(int);
    callback unpin-place(int);
    callback grid-columns-changed(int);
    callback search-changed(string);
    callback confirm-dialog(string);
    callback dismiss-dialog();
    callback context-entry(int);
    callback keyboard(string, bool, bool, bool);
    callback choose-application(int);
    public function focus-files() {
        if FilePreview.visible { FilePreview.focus-generation += 1; }
        else if ArchiveBrowser.visible { ArchiveBrowser.focus-generation += 1; }
        else { files-keys.focus(); }
    }
    public function focus-inline-menu() { actions-menu.focus-menu(); }
    public function dismiss-menu() { root.menu-kind = 0; root.native-popup-active = false; root.focus-files(); }
    public function activate-menu(action: string) {
        if action == "unpin" { root.menu-kind = 0; root.unpin-place(root.menu-place); root.focus-files(); }
        else if action == "open-place" { root.menu-kind = 0; root.open-place(root.menu-place); root.focus-files(); }
        else if action == "open-place-tab" { root.menu-kind = 0; root.action-on-place("open-tab", root.menu-place); root.focus-files(); }
        else if action == "place-terminal" { root.menu-kind = 0; root.action-on-place("terminal", root.menu-place); root.focus-files(); }
        else if action == "copy-place-path" { root.menu-kind = 0; root.action-on-place("copy-path", root.menu-place); root.focus-files(); }
        else if action == "place-properties" { root.menu-kind = 0; root.action-on-place("properties", root.menu-place); root.focus-files(); }
        else if action == "open-disk" { root.menu-kind = 0; root.open-disk(); root.focus-files(); }
        else if action == "open-disk-tab" { root.menu-kind = 0; root.action("open-disk-tab"); root.focus-files(); }
        else if action == "disk-terminal" { root.menu-kind = 0; root.action("disk-terminal"); root.focus-files(); }
        else if action == "copy-disk-path" { root.menu-kind = 0; root.action("copy-disk-path"); root.focus-files(); }
        else if action == "disk-properties" { root.menu-kind = 0; root.action("disk-properties"); root.focus-files(); }
        else if action == "close-tab-menu" { root.menu-kind = 0; root.close-tab(root.menu-tab); root.focus-files(); }
        else if action == "close-other-tabs" { root.menu-kind = 0; root.action-on-tab("close-others", root.menu-tab); root.focus-files(); }
        else if action == "close-tabs-right" { root.menu-kind = 0; root.action-on-tab("close-right", root.menu-tab); root.focus-files(); }
        else if action == "duplicate-tab" { root.menu-kind = 0; root.action-on-tab("duplicate", root.menu-tab); root.focus-files(); }
        else if action == "copy-tab-path" { root.menu-kind = 0; root.action-on-tab("copy-path", root.menu-tab); root.focus-files(); }
        else { root.run(action); }
    }
    public function focus-location() { location-field.focus-input(); location-field.select-all(); }
    public function focus-search() { search-field.focus-input(); search-field.select-all(); }
    public function focus-dialog() {
        if root.dialog-kind == 1 || root.dialog-kind == 2 || root.dialog-kind == 6 || root.dialog-kind == 9 { dialog-field.focus-input(); dialog-field.select-all(); }
        else if root.dialog-kind == 5 { application-chooser.focus-chooser(); }
        else if root.dialog-kind == 10 { properties-panel.focus-panel(); }
        else { dialog-keys.focus(); }
    }
    public function cancel-drag-gesture() {
        root.pointer-held = false; root.rectangle-gesture = false; root.rectangle-visible = false;
        root.drag-threshold-crossed = false; root.deferred-selection = false; root.pressed-entry = -1;
        root.last-left-entry = -1; root.previous-left-entry = -1;
    }
    function update-selection-rectangle() {
        root.update-rectangle(root.press-x / 1px, root.press-content-y / 1px,
            root.pointer-x / 1px, (root.pointer-y - root.content-offset) / 1px,
            (root.grid-view ? root.grid-cell-size : file-input.width) / 1px,
            (root.grid-view ? root.grid-cell-size : root.row-height) / 1px,
            (root.grid-view ? root.grid-gap : 0px) / 1px, root.grid-view ? root.grid-columns : 1);
    }

    function begin-file-gesture(index: int, x: length, y: length, control: bool, shift: bool) {
        root.pressed-entry = index;
        root.pointer-held = true; root.drag-threshold-crossed = false;
        root.deferred-selection = index >= 0 && root.entries[index].selected;
        root.press-control = control; root.press-shift = shift;
        root.press-x = x; root.press-content-y = y - root.content-offset;
        root.pointer-x = x; root.pointer-y = y;
        root.previous-left-entry = root.last-left-entry; root.last-left-entry = index;
        if index >= 0 {
            if !root.deferred-selection && (control || shift) { root.select-entry(index, control, shift); }
            else { root.context-entry(index); }
        } else {
            root.rectangle-gesture = true; root.begin-rectangle(control, shift);
        }
        root.focus-files();
    }
    function move-file-gesture(x: length, y: length) {
        root.hovered-entry = root.entry-at(x, y);
        root.pointer-x = x; root.pointer-y = y;
        if root.pointer-held && (Math.abs(x - root.press-x) > 5px || Math.abs(y - root.content-offset - root.press-content-y) > 5px) {
            if root.rectangle-gesture { root.rectangle-visible = true; root.update-selection-rectangle(); }
            else if !root.drag-threshold-crossed && root.pressed-entry >= 0 && !root.trash-view {
                root.drag-threshold-crossed = true;
                root.begin-file-drag(root.pressed-entry);
            }
        }
    }
    function end-file-gesture() {
        if root.rectangle-gesture { root.finish-rectangle(false); }
        else if root.pointer-held && !root.drag-threshold-crossed && root.pressed-entry >= 0 && (root.deferred-selection || (!root.press-control && !root.press-shift)) { root.select-entry(root.pressed-entry, root.press-control, root.press-shift); }
        root.pointer-held = false; root.rectangle-gesture = false; root.rectangle-visible = false; root.deferred-selection = false;
    }
    function cancel-file-gesture() {
        if root.rectangle-gesture { root.finish-rectangle(true); }
        root.cancel-drag-gesture();
    }
    public pure function drop-target(x: length, y: length) -> int {
        if FilePreview.visible || ArchiveBrowser.visible || FilePicker.active || root.dialog-kind > 0 || root.menu-kind > 0 || root.busy || root.operation-active || root.trash-view { return -2147483647; }
        if x >= places-view.absolute-position.x && x < places-view.absolute-position.x + places-view.width
            && y >= places-view.absolute-position.y && y < places-view.absolute-position.y + places-view.height {
            let place = root.place-at(root.places, y - places-view.absolute-position.y - places-view.viewport-y,
                root.row-height, Theme.font-size-sm + Theme.spacing-lg * 2);
            return place >= 0 ? -place - 2 : -2147483647;
        }
        if x < content.absolute-position.x || x >= content.absolute-position.x + content.width
            || y < content.absolute-position.y || y >= content.absolute-position.y + content.height { return -2147483647; }
        let index = root.entry-at(x - file-area.absolute-position.x, y - file-area.absolute-position.y);
        return index >= 0 && root.entries[index].is-dir ? index : -1;
    }
    public function reveal-entry(index: int) {
        list.viewport-y = Math.min(0px, Math.max(Math.min(0px, list.height - root.entries.length * root.row-height), -index * root.row-height + list.height / 2));
        grid.viewport-y = Math.min(0px, Math.max(Math.min(0px, grid.height - root.grid-rows.length * (root.grid-cell-size + root.grid-gap)), -Math.floor(index / root.grid-columns) * (root.grid-cell-size + root.grid-gap) + grid.height / 2));
    }
    changed grid-columns => { root.grid-columns-changed(root.grid-columns); }
    changed location => {
        list.viewport-y = 0px;
        grid.viewport-y = 0px;
    }
    changed active-tab => {
        list.viewport-y = 0px;
        grid.viewport-y = 0px;
        tabs-view.viewport-x = Math.min(0px, Math.max(tabs-view.width - tabs-view.viewport-width, -root.active-tab * root.tab-step));
    }
    changed busy => { if root.busy { root.cancel-drag-gesture(); } }
    changed grid-view => { root.cancel-drag-gesture(); }
    changed menu-kind => { if root.menu-kind == 0 { root.native-popup-active = false; root.close-native-menu(); } }
    changed dialog-kind => {
        root.cancel-drag-gesture();
        root.menu-kind = 0;
        if root.dialog-kind > 0 { root.focus-dialog(); } else { root.focus-files(); }
    }
    function run(action: string) { root.menu-kind = 0; root.action(action); if root.dialog-kind == 0 { root.focus-files(); } }
    function open-menu(kind: int, x: length, y: length) {
        root.menu-x = x; root.menu-y = y; root.menu-kind = kind;
        root.native-popup-active = root.show-native-menu(actions-menu.items, actions-menu.accessible-name, actions-menu.x, actions-menu.y, actions-menu.preferred-menu-width, actions-menu.height);
        if !root.native-popup-active { actions-menu.focus-menu(); }
    }
    function file-menu(index: int, x: length, y: length) { root.context-entry(index); root.open-menu(1, x, y); }
    function folder-menu(x: length, y: length) { root.run("clear-selection"); root.open-menu(2, x, y); }

    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: !root.using-desktop-material ? Theme.window-background.with-alpha(1) : Theme.panel-frame.available ? transparent : @linear-gradient(180deg, Theme.glass-start 0%, Theme.glass-end 100%);
        if root.using-desktop-material && Theme.panel-frame.available: ThemeFrame {
            width: parent.width; height: parent.height; skin: Theme.panel-frame;
            square-corners: true; material-opacity: Theme.material-opacity;
        }
    }
    pure function entry-at(x: length, y: length) -> int {
        if root.busy || x < 0px || y < 0px || x >= file-area.width - Theme.scrollbar-gutter || y >= file-area.height { return -1; }
        if root.grid-view {
            let step = root.grid-cell-size + root.grid-gap;
            let content-y = y - grid.viewport-y;
            let column = Math.floor(x / step);
            let row = Math.floor(content-y / step);
            let index = row * root.grid-columns + column;
            return Math.mod(x / 1px, step / 1px) < root.grid-cell-size / 1px && Math.mod(content-y / 1px, step / 1px) < root.grid-cell-size / 1px && column < root.grid-columns && index >= 0 && index < root.entries.length ? index : -1;
        }
