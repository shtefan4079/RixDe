                            if backwards { dialog-field.focus-input(); } else { dialog-confirm.focus-button(); }
                        } else {
                            if backwards { dialog-cancel.focus-button(); } else { dialog-field.focus-input(); }
                        }
                    } else if root.dialog-kind == 3 || root.dialog-kind == 8 {
                        if dialog-cancel.has-focus { dialog-confirm.focus-button(); } else { dialog-cancel.focus-button(); }
                    } else {
                        dialog-cancel.focus-button();
                    }
                    return accept;
                }
                if e.text == Key.Return {
                    if root.dialog-kind < 4 || root.dialog-kind == 6 || root.dialog-kind == 8 || root.dialog-kind == 9 { root.confirm-dialog(root.dialog-value); }
                    else { root.dismiss-dialog(); }
                    return accept;
                }

                if e.modifiers.control || e.modifiers.alt { return accept; }
                reject
            }
        MenuSurface { x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
            width: Math.max(0px, Math.min(480px, parent.width - Theme.spacing-xl * 2));
            height: Math.max(0px, Math.min(parent.height - Theme.spacing-xl * 2, dialog-content.preferred-height));
            blur-local-content: true;
            material-supported: root.using-desktop-material;
            opaque: !root.using-desktop-material;
            dialog-content := VerticalLayout { padding: Theme.spacing-xl + 4px; spacing: Theme.spacing-lg;
                Text { text: root.dialog-title; color: Theme.text-primary; font-size: Theme.font-size-xl; font-weight: 700; wrap: word-wrap; }
                message-scroll := ScrollArea {
                    visible: root.dialog-text != "";
                    min-height: 0px;
                    preferred-height: self.visible ? Math.min(Theme.font-size-md * 9, message.preferred-height) : 0px;
                    max-height: self.visible ? 65535px : 0px;
                    vertical-stretch: 1;
                    content-height: message.preferred-height;
                    message := Text { width: message-scroll.content-width; text: root.dialog-text; color: Theme.text-secondary; font-size: Theme.font-size-md; wrap: word-wrap; }
                }
                dialog-field := Field { visible: root.dialog-kind == 1 || root.dialog-kind == 2 || root.dialog-kind == 6 || root.dialog-kind == 9; min-height: self.visible ? Theme.icon-size + Theme.default-spacing * 2 : 0px; preferred-height: self.min-height; max-height: self.min-height; placeholder: root.dialog-title; text <=> root.dialog-value; accepted(value) => { root.confirm-dialog(value); } escape => { root.dismiss-dialog(); } }
                dialog-footer := HorizontalLayout {
                    private property <bool> confirming: root.dialog-kind < 4 || root.dialog-kind == 6 || root.dialog-kind == 8 || root.dialog-kind == 9;
                    alignment: end;
                    spacing: Theme.spacing-lg;
                    dialog-cancel := Button {
                        text: root.dialog-kind == 4 ? @tr("Close") : @tr("Cancel");
                        clicked => { root.dismiss-dialog(); }
                    }
                    dialog-confirm := Button {
                        visible: dialog-footer.confirming;
                        text: root.dialog-kind == 3 ? @tr("Delete permanently") : root.dialog-kind == 1 || root.dialog-kind == 6 ? @tr("Create") : root.dialog-kind == 2 ? @tr("Rename") : @tr("Confirm");
                        destructive: root.dialog-kind == 3;
                        active: true;
                        clicked => { root.confirm-dialog(root.dialog-value); }
                    }
                }
            }
        }
        }
    }
}
