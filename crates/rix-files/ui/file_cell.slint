import { Theme } from "../../../ui/common/theme.slint";
import { FileItem } from "models.slint";

export component FileCell inherits Rectangle {
    in property <FileItem> item;
    in property <bool> grid;
    in property <bool> hovered;
    in property <bool> drop-target;
    in property <bool> show-type;
    in property <length> size-column;
    in property <length> modified-column;
    in property <length> type-column;
    callback selected(bool, bool);
    callback activated();
    callback context(length, length);
    private property <bool> ctrl;
    private property <bool> shift;
    border-radius: Theme.radius-sm;
    background: root.drop-target ? Theme.accent.with-alpha(0.16) : root.item.selected ? Theme.surface-active : root.hovered || touch.has-hover ? Theme.surface-hover : transparent;
    animate background { duration: Theme.hover-duration * 1ms; easing: ease-out; }
    border-width: root.drop-target ? 2px : root.item.selected || root.item.focused ? 1px : 0px;
    border-color: root.drop-target || root.item.selected || root.item.focused ? Theme.accent : Theme.border;
    opacity: root.item.name == "" ? 0 : root.item.cut ? 0.45 : root.item.is-hidden ? 0.6 : 1;
    accessible-role: list-item; accessible-label: root.item.name;
    accessible-item-selectable: root.item.name != ""; accessible-item-selected: root.item.selected;
    accessible-action-default => { if root.item.name != "" { root.activated(); } }
    private property <length> type-left: root.width - Theme.default-spacing - root.type-column;
    private property <length> modified-left: root.width - Theme.default-spacing - (root.show-type ? root.type-column + Theme.default-spacing : 0px) - root.modified-column;
    private property <length> size-left: root.modified-left - Theme.default-spacing - root.size-column;
    if !root.grid: Rectangle {
        Image { x: Theme.default-spacing; y: (parent.height - self.height)/2; source: root.item.icon; width: Theme.icon-size-lg; height: self.width; image-fit: contain; }
        Text { x: Theme.default-spacing * 2 + Theme.icon-size-lg; y: 0px; width: Math.max(0px, root.size-left - self.x - Theme.default-spacing); height: parent.height; text: root.item.name; color: root.item.is-hidden ? Theme.text-secondary : Theme.text-primary; font-size: Theme.font-size-md; vertical-alignment: center; overflow: elide; }
        Text { x: root.size-left; y: 0px; height: parent.height; text: root.item.size; color: Theme.text-secondary; font-size: Theme.font-size-sm; width: root.size-column; horizontal-alignment: right; vertical-alignment: center; }
        Text { x: root.modified-left; y: 0px; height: parent.height; text: root.item.modified; color: Theme.text-secondary; font-size: Theme.font-size-sm; width: root.modified-column; vertical-alignment: center; }
        if root.show-type: Text { x: root.type-left; y: 0px; height: parent.height; text: root.item.detail; color: Theme.text-muted; font-size: Theme.font-size-sm; width: root.type-column; vertical-alignment: center; overflow: elide; }
    }
    if root.grid: Rectangle {
        private property <length> name-height: Theme.font-size-md * 2.8;
        private property <length> group-height: Theme.icon-size-lg * 2 + Theme.spacing-xs + self.name-height;
        private property <length> group-top: Math.max(Theme.spacing-lg, (root.height - self.group-height) / 2);
        Image { x: (parent.width - self.width) / 2; y: parent.group-top; width: Theme.icon-size-lg * 2; height: self.width; source: root.item.icon; image-fit: contain; }
        Text { x: Theme.spacing-lg; y: parent.group-top + Theme.icon-size-lg * 2 + Theme.spacing-xs; width: parent.width - self.x * 2; height: parent.name-height; text: root.item.name; color: root.item.is-hidden ? Theme.text-secondary : Theme.text-primary; font-size: Theme.font-size-md; horizontal-alignment: center; vertical-alignment: top; overflow: elide; wrap: word-wrap; }
    }
    touch := TouchArea {
        enabled: root.item.name != "";
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.ctrl = e.modifiers.control; root.shift = e.modifiers.shift;
                if e.button == PointerEventButton.right { root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
            }
        }
        clicked => { root.selected(root.ctrl, root.shift); }
        double-clicked => { root.activated(); }
    }
}
